    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "model = LinearRegression()\n",
    "\n",
    "X = [[1], [2], [3]] # X Axis\n",
    "y = [22, 44, 66] # Results\n",
    "\n",
    "model.fit(X, y) # Learn from this data\n",
    "\n",
    "print(model.predict([[4]])) # Output: 8"
   ]
  }
